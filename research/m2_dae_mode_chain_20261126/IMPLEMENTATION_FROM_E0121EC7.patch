+#[derive(Clone, Debug, Serialize)]
+pub struct VectorResetComponent {
+    pub enclosure: [f64; 2],
+    pub transport_error: f64,
+    pub reduced_lip: f64,
+    pub prepared_work: InitWork,
+    #[serde(skip)]
+    power: Poly,
+    #[serde(skip)]
