+        let landed = t + h;
+        if landed == target {
+            return Ok(h);
+        }
+        if landed < target {
+            if landed > t {
+                below = Some(below.map_or(h, |best: f64| best.max(h)));
+            }
+            h = h.next_up();
+        } else {
+            h = h.next_down();
+        }
+    }
+    below.ok_or_else(|| {
+        CoreError::InvalidInput(format!(
+            "no binary64 step advances t = {t:e} toward {target:e}"
+        ))
+    })
 }
 
