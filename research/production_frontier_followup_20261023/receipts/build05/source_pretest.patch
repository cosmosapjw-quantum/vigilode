+/// Stage at which an unrecoverable native session error was observed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Rodas5pSessionFailureKind {
+    CallbackError,
+    Clock,
+    Output,
+    Controller,
+}
