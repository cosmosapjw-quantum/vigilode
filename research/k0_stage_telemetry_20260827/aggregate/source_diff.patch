+      "severity_if_violated": "P0",
+      "statement": "N_i = f_i - f_0 - J_n(Y_i-y_n) - c_i h f_t,n under the repository sign convention.",
+      "mechanical_check": {"command": "cargo test -p rodas5p-integrators --test k0_stage_telemetry_contracts nonlinear_remainder_equation_map", "expect": "PASS"}
+    },
+    {
+      "id": "INV-K0-013",
+      "severity_if_violated": "P0",
+      "statement": "scaled_nonlinear_remainder equals ||N_i||_2 / max(||f_i||_2, ||f_0||_2, ||J_n(Y_i-y_n)||_2, ||c_i h f_t,n||_2, f64::MIN_POSITIVE), with no WRMS substitution and no cap at one.",
+      "mechanical_check": {"command": "cargo test -p rodas5p-integrators --test k0_stage_telemetry_contracts scaled_nonlinear_remainder_exact_oracle_and_mutations", "expect": "PASS"}
+    }
+  ],
