+    {"id": "FM-WU03-002", "severity": "P0", "trigger": "Hidden telemetry JVP", "required_detection": {"test": "overhead delta"}},
+    {"id": "FM-WU03-003", "severity": "P1", "trigger": "Nondeterministic token", "required_detection": {"test": "cross-process token"}},
+    {"id": "FM-WU03-004", "severity": "P1", "trigger": "Duplicate SVD implementation", "required_detection": {"test": "source scan"}},
+    {"id": "FM-WU03-005", "severity": "P0", "trigger": "Normalization drift", "required_detection": {"test": "exact oracle plus denominator, WRMS, missing-time-term, and cap-at-one mutations"}}
+  ],
+  "implementation": {
+    "ordered_steps": [
+      {
+        "id": "STEP-301",
+        "files": ["crates/rodas5p-integrators/tests/k0_stage_telemetry_contracts.rs"],
+        "action": "Write RED tests for stage identities, injected errors, exact rho_i oracle and mutations, equation map, scale invariance, deterministic tokens, and overhead.",
+        "must_preserve": ["solver outputs and acceptance"]
+      },
+      {
+        "id": "STEP-302",
+        "files": ["crates/rodas5p-integrators/src/rhs_telemetry.rs"],
+        "action": "Reuse existing faer SVD and subspace helpers for normalized prefix and RHS novelty telemetry.",
+        "must_preserve": ["existing homotopy telemetry outputs and recommendations"]
+      },
+      {
+        "id": "STEP-303",
+        "files": ["crates/rodas5p-integrators/src/sequential.rs"],
+        "action": "Add an opt-in wrapper and compute checked stage deltas and the exact rho_i from already available terms.",
+        "must_preserve": ["sequential_stages route and recycle transaction"]
+      },
+      {
+        "id": "STEP-304",
+        "files": ["crates/rodas5p-integrators/src/a1_two_arm_receipt.rs", "crates/rodas5p-cli/src/bin/*k0*"],
+        "action": "Serialize explicit stage and cell receipts with deterministic ordering and claim boundary.",
+        "must_preserve": ["PR #20 selector and LegacyFixed semantics"]
+      }
+    ]
+  },
+  "verification": {
+    "targeted": [
+      "cargo test -p rodas5p-integrators --test k0_stage_telemetry_contracts",
+      "cargo test -p rodas5p-integrators --test a1_two_arm_receipt_contracts"
+    ],
+    "negative": [
+      "stage-3 injected error",
+      "duplicate or missing stage ID",
+      "diagnostic omission",
+      "remainder sign mutation",
+      "independent RHS scaling",
+      "denominator replaced by ||f_i||_2 only",
+      "tolerance-weighted WRMS substitution",
+      "time-derivative term omitted",
+      "result capped at one"
+    ],
+    "regression": [
+      "cargo test -p rodas5p-integrators rhs_telemetry",
+      "cargo test -p rodas5p-integrators matrix_free"
+    ],
+    "integration": ["cargo check --workspace --all-targets --locked"],
+    "full_relevant_suite": []
+  },
+  "completion_evidence": {
+    "required": [
+      "stage_receipt_samples",
+      "mutation_results",
+      "production_parity_receipt",
+      "source_diff",
+      "scaled_nonlinear_remainder_oracle_results"
+    ]
+  },
