+        config.method,
+        config.rtol.to_bits(),
+        config.atol.to_bits(),
+        config.restart,
+        config.maxiter,
+        config.inner_m,
+        config.outer_k,
+        config.recycle_dim,
+        config.recycle_rank_tol.to_bits(),
+        config.preconditioner,
+        config.x0_strategy,
+        kernel.as_str(),
+    );
+    sha256_hex(canonical.as_bytes())
