+  "objective": {
+    "statement": "Integrate stage-local checked work, the exact scaled nonlinear remainder, RHS geometry, deterministic identities, and explicit failure receipts into the receipt-only sequential path.",
+    "observable_success": "Every attempted stage has a validated COMPLETE, STOP_INVALID, or ERROR receipt, and every complete attempted step has stages 0 through 7 exactly once without changing production behavior.",
+    "non_goals": ["Production activation", "Timing or speedup claim", "Changing scientific tolerances or expected outputs"]
+  },
+  "risk": {
+    "class": "critical",
+    "P0_failure_modes": [
+      {
+        "id": "FM-WU03-001",
+        "severity": "P0",
+        "trigger": "A stage failure returns before emitting an ERROR receipt with preserved counters.",
+        "required_detection": {"test": "injected stage failure preserves prior COMPLETE and current ERROR"}
+      },
+      {
+        "id": "FM-WU03-002",
+        "severity": "P0",
+        "trigger": "Telemetry remainder JVP is uncounted or folded into linear work.",
+        "required_detection": {"test": "telemetry_jvp_overhead exact delta"}
+      },
+      {
+        "id": "FM-WU03-005",
+        "severity": "P0",
+        "trigger": "scaled_nonlinear_remainder uses any norm, denominator, floor, time-term treatment, or cap other than the frozen rho_i authority.",
+        "required_detection": {"test": "scaled_nonlinear_remainder_exact_oracle_and_mutations"}
+      }
+    ],
+    "P1_failure_modes": [
+      {
+        "id": "FM-WU03-003",
+        "severity": "P1",
+        "trigger": "Preconditioner identity uses pointer or address identity.",
+        "required_detection": {"test": "deterministic configuration token across processes"}
+      },
+      {
+        "id": "FM-WU03-004",
+        "severity": "P1",
+        "trigger": "RHS SVD duplicates prototype machinery instead of reusing canonical faer machinery.",
+        "required_detection": {"test": "source-diff duplicate implementation scan"}
+      }
+    ]
+  },
+  "scope": {
+    "allowed_paths": [
+      "crates/rodas5p-integrators/src/sequential.rs",
+      "crates/rodas5p-integrators/src/rhs_telemetry.rs",
+      "crates/rodas5p-integrators/src/a1_two_arm_receipt.rs",
