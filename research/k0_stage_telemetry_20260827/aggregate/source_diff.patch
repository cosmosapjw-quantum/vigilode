+{
+  "schema": "audit-compiled-work-unit/v1",
+  "id": "WU-03",
+  "title": "Opt-in stage receipts and failure-preserving aggregate",
+  "authority": {
+    "base_sha": "e1124586a4029f86669e7489278c61ef676d61aa",
+    "base_branch": "research/a1-post-a2a3-kernel-rerun",
+    "implementation_branch": "research/k0-stage-telemetry-integration-20260827",
