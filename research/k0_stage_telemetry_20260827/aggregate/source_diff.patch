+    {
+      "id": "PRE-301",
+      "command": "cargo test -p rodas5p-integrators --test k0_stage_telemetry_contracts solver_observation",
+      "expect": "PASS"
+    },
+    {
+      "id": "PRE-302",
+      "command": "python tools/verify-k0-stage-telemetry-plan.py --repo-root . --check-package --check-spec-repair-authority",
+      "expect": "PACKAGE_CONTRACT_PASS and SPEC_REPAIR_AUTHORITY_PASS"
+    }
+  ],
+  "invariants": [
+    {
+      "id": "INV-K0-003",
+      "severity_if_violated": "P0",
+      "statement": "Stage accounting closure is exact.",
+      "mechanical_check": {"command": "cargo test -p rodas5p-integrators --test k0_stage_telemetry_contracts stage_accounting_closes", "expect": "PASS"}
+    },
+    {
+      "id": "INV-K0-005",
+      "severity_if_violated": "P0",
+      "statement": "All attempted stages are explicit and complete steps contain 0 through 7 exactly once.",
+      "mechanical_check": {"command": "cargo test -p rodas5p-integrators --test k0_stage_telemetry_contracts stage_identity_is_exhaustive", "expect": "PASS"}
