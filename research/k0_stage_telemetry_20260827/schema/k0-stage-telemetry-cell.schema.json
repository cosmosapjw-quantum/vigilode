{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cosmosapjw-quantum/vigilode/schemas/k0-stage-telemetry-cell-v1.json",
  "title": "VigilODE K0 Stage Telemetry Cell",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_class",
    "execution_state",
    "repository",
    "source_pull_request",
    "source_base_sha",
    "source_base_tree",
    "execution_head_sha",
    "execution_head_tree",
    "rust_version",
    "cargo_version",
    "case_id",
    "family",
    "kernel_arm",
    "tolerance",
    "solver_configuration_tokens",
    "stages",
    "receipt",
    "error",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "vigilode-k0-stage-telemetry-cell/v1"},
    "claim_class": {"const": "EXPLORATORY_NONAUTHORITATIVE"},
    "execution_state": {"enum": ["COMPLETE", "STOP_INVALID", "ERROR"]},
    "repository": {"const": "cosmosapjw-quantum/vigilode"},
    "source_pull_request": {"const": 20},
    "source_base_sha": {"const": "e1124586a4029f86669e7489278c61ef676d61aa"},
    "source_base_tree": {"const": "adbb933cf3bf3d401d652c8a6d9df661d8500a2b"},
    "execution_head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "execution_head_tree": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "rust_version": {"type": "string", "minLength": 1},
    "cargo_version": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "family": {"enum": [
      "robertson-ramped",
      "hires-ramped",
      "van-der-pol-ramped",
      "rotating-nonnormal",
      "nonautonomous-stiff-forcing",
      "semilinear-advection-diffusion-ramped"
    ]},
    "kernel_arm": {"enum": ["legacy-restarted-gmres", "incremental-givens-candidate"]},
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rtol", "atol"],
      "properties": {
        "kind": {"const": "LegacyFixed"},
        "rtol": {"const": 1e-10},
        "atol": {"const": 1e-12}
      }
    },
    "solver_configuration_tokens": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
      "uniqueItems": true
    },
    "stages": {
      "type": "array",
      "items": {"type": "object"}
    },
    "receipt": {
      "type": ["object", "null"]
    },
    "error": {
      "type": ["object", "null"]
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
