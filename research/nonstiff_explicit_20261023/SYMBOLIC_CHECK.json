  "python_source": "from fractions import Fraction as Q\nfrom itertools import combinations_with_replacement\nfrom functools import cache\nimport json\nA=[[Q(0) for _ in range(7)] for _ in range(7)]\nrows=[[],['1/5'],['3/40','9/40'],['44/45','-56/15','32/9'],['19372/6561','-25360/2187','64448/6561','-212/729'],['9017/3168','-355/33','46732/5247','49/176','-5103/18656'],['35/384','0','500/1113','125/192','-2187/6784','11/84']]\nfor i,row in enumerate(rows):\n for j,v in enumerate(row):A[i][j]=Q(v)\nb=A[-1].copy(); bh=list(map(Q,['5179/57600','0','7571/16695','393/640','-92097/339200','187/2100','1/40'])); c=list(map(sum,A))\n@cache\ndef order(t):return 1+sum(map(order,t))\n@cache\ndef gamma(t):\n g=order(t)\n for x in t:g*=gamma(x)\n return g\nT={1:[()]}\nfor n in range(2,6):\n allprev=[t for k in range(1,n) for t in T[k]]\n T[n]=[forest for k in range(1,n) for forest in combinations_with_replacement(allprev,k) if sum(map(order,forest))==n-1]\ndef evaluate(a,b,bh):\n @cache\n def phi(t):\n  ans=[Q(1) for _ in a]\n  for child in t:\n   v=phi(child);av=[sum(x*y for x,y in zip(row,v)) for row in a];ans=[x*y for x,y in zip(ans,av)]\n  return tuple(ans)\n records=[]\n for n in range(1,6):\n  for t in T[n]:\n   val=sum(x*y for x,y in zip(b,phi(t)));emb=sum(x*y for x,y in zip(bh,phi(t)));target=Q(1,gamma(t))\n   assert val==target\n   if n<=4:assert emb==target\n   records.append({'tree':repr(t),'order':n,'b5':str(val),'exact':str(target),'b4':str(emb),'b4_required':n<=4})\n return records\nbase=evaluate(A,b,bh)\nAA=[[Q(0) for _ in range(16)]];CC=[Q(0)];old=[0]*7\nfor q in range(1,5):\n new=old.copy()\n for i in range(q,6):\n  row=[Q(0)]*16\n  for j in range(i):row[old[j]]+=A[i][j]\n  new[i]=len(AA);AA.append(row);CC.append(c[i])\n old=new\nBB=[Q(0)]*16\nfor i in range(6):BB[old[i]]+=b[i]\nAA.append(BB.copy());CC.append(Q(1));old[6]=15\nBH=[Q(0)]*16\nfor i in range(7):BH[old[i]]+=bh[i]\nassert len(AA)==16 and list(map(sum,AA))==CC\npara=evaluate(AA,BB,BH)\nencode=lambda o:[[str(x) for x in row] for row in o]\nout={'arithmetic':'Python fractions.Fraction exact rational','rooted_tree_counts':[len(T[i]) for i in range(1,6)],'base_tableau':{'A':encode(A),'c':list(map(str,c)),'b5':list(map(str,b)),'b4':list(map(str,bh))},'base_order_conditions':base,'parallel_tableau':{'A':encode(AA),'c':list(map(str,CC)),'b5':list(map(str,BB)),'b4':list(map(str,BH)),'warm_rhs_calls':15,'warm_sequential_batches':5,'fsal':AA[-1]==BB and CC[-1]==1},'parallel_order_conditions':para,'all_conditions_pass':True}\nprint(json.dumps(out,indent=2))\n",
