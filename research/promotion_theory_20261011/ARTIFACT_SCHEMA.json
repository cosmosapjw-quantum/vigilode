{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cosmosapjw-quantum/vigilode/research/promotion_theory_20261011/ARTIFACT_SCHEMA.json",
  "title": "VigilODE conditional theorem decisions",
  "type": "object",
  "required": ["schema_version", "baseline_commit", "scope", "claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope": {"const": "DERIVED_CONDITIONAL_THEOREMS_NOT_NATIVE_PROMOTION"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "decision", "promotion_scope", "assumptions", "conclusion", "proof", "independent_review", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["PROMOTE", "HOLD", "REJECT"]},
          "promotion_scope": {"type": "string", "minLength": 1},
          "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "conclusion": {"type": "string", "minLength": 1},
          "proof": {"type": "object", "required": ["path", "section"], "properties": {"path": {"type": "string"}, "section": {"type": "string"}}},
          "independent_review": {"type": "string"},
          "evidence_status": {"type": "array", "contains": {"const": "derived"}}
        }
      }
    }
  }
}
