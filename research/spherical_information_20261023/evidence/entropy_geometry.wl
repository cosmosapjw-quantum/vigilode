Clear[n,r,c,k,t,dn,dt]; f=n Log[27 n^4/(2 c r^3)]-4 n; hh=Table[D[f,a,b],{a,{n,r}},{b,{n,r}}]; jac={{1,0},{3 t,3 n}}; g=FullSimplify[Transpose[jac].(hh/.r->3 n t).jac,Assumptions->n>0&&t>0&&c>0]; scalar=D[-k r^(3/4),{r,2}]; z=2 Sqrt[3 k]/3 r^(3/8); ExportString[<|"hessian"->ToString[hh,InputForm],"determinant"->ToString[Factor[Det[hh]],InputForm],"metric_n_T"->ToString[g,InputForm],"scalar_hessian"->ToString[scalar,InputForm],"fisher_coordinate_identity"->FullSimplify[D[z,r]^2==scalar,Assumptions->k>0&&r>0]|>,"RawJSON"]
