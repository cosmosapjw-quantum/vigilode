ClearAll[z,k,w,s,a,b,c,l,u]; q=(z+k)^2+w^2; den=(1+s k)^2+(s w)^2; p=(1+2 s k+s z)/den; test=FullSimplify[PolynomialRemainder[Together[(1-s z)*p-1] den,q,z]]; uu=2 b/(a+Sqrt[a^2+4 l c b]); root=FullSimplify[l c uu^2+a uu-b,Assumptions->a>0 && Element[{a,b,c,l},Reals] && a^2+4 l c b>0]; deriv=FullSimplify[a+2 l c uu,Assumptions->a>0 && Element[{a,b,c,l},Reals] && a^2+4 l c b>0]; identity=Factor[(c u^2+a u-b)-(u-uu)*(a+c(u+uu))/.l->1]; {test,root,deriv,FullSimplify[identity,Assumptions->a>0 && Element[{a,b,c,u},Reals] && a^2+4 c b>0]}
