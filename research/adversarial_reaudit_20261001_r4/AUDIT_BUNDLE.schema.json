{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VigilODE R4 source-bound audit bundle",
  "type": "object",
  "required": [
    "schema_version",
    "source_commit",
    "preregistration_commit",
    "branch",
    "verdict",
    "production_modified",
    "new_branch_created",
    "findings",
    "closure",
    "claims",
    "development",
    "topological_order",
    "numeric_results",
    "runtime",
    "independent_review",
    "report",
    "reproduce"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "vigilode.r4.audit_bundle.v1"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "preregistration_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "REWORK"
      ]
    },
    "production_modified": {
      "const": false
    },
    "new_branch_created": {
      "const": false
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "title",
          "status",
          "scope",
          "source_locations",
          "owner_evidence",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "P2",
              "P3"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "source_locations": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "closure": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node",
          "status",
          "evidence_summary",
          "scope"
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "evidence_level",
          "claim_ceiling",
          "owner_record",
          "independent_disposition"
        ]
      }
    },
    "development": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "title",
          "state",
          "depends_on",
          "targets",
          "implementation",
          "acceptance",
          "kill_or_stop_criterion",
          "claim_ceiling",
          "owner_plan"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "P2",
              "P3"
            ]
          },
          "state": {
            "const": "PROPOSED_NOT_IMPLEMENTED"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "implementation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "kill_or_stop_criterion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "topological_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "numeric_results": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "independent_review": {
      "type": "string",
      "minLength": 1
    },
    "report": {
      "type": "string",
      "minLength": 1
    },
    "reproduce": {
      "type": "string",
      "minLength": 1
    }
  }
}
