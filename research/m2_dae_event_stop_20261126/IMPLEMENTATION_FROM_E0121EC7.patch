+/// Root-search routes. All require the same source-owned physical tube;
+/// a represented-polynomial hint has no physical authority.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+pub enum ThresholdRoute {
+    Bisection,
+    IntervalNewton,
+    DictionaryHint,
+}
