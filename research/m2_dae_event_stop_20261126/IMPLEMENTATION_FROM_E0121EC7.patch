+        let mut lo = a;
+        let mut hi = b;
+        let mut hint = None;
+        if self.route == ThresholdRoute::DictionaryHint {
+            use rodas5p_integrators::retro_event_poly::{RepresentedPolynomial, RootRoute};
+            self.work.hint_calls += 1;
+            let mut cp = p[0]
+                .iter()
+                .map(|v| v.lo * 0.5 + v.hi * 0.5)
+                .collect::<Vec<_>>();
