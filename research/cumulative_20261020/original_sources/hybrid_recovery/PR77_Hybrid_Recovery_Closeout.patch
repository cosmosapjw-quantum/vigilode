+    "-al q1/3 - al q2/3 - 4 al q3/3 - 2 ep q3"
+  ],
+  "interpretation": "Each row expression is -alpha*(mean+q_i)-2*epsilon*q_i; nonpositive on the declared parameter/state box.",
+  "not_claimed": "A new Rust test or a complete continuous certificate replay"
+}
