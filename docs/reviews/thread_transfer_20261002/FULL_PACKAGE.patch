@@ -0,0 +1,109 @@
+"""Research-only JVP-only transformed-stage comparison, not vigilode Rust runtime.
+
+The raw snapshot is byte-verified. Gamma is rederived here with NumPy rather
+than faer, so this checks algebraic/rounding-level agreement, not native
+StageTarget bit identity. GMRES is a small, reorthogonalized reference and
+is not a proposed production Krylov implementation.
+"""
+from __future__ import annotations
+import json,hashlib
+from pathlib import Path
+import numpy as np
+ROOT=Path(__file__).resolve().parents[1]
+
+def tableau():
+    source=ROOT.parents[2]/'fixtures/rodas5p_coefficients_snapshot.json'
+    selected=json.loads((ROOT/'inputs/rodas5p_coefficients_selected.json').read_text())
+    if source.exists():
+        data=source.read_bytes()
+        assert hashlib.sha256(data).hexdigest()==selected['_source']['snapshot_sha256']
+        d=json.loads(data)
+        assert all(d[k]==selected[k] for k in ['gamma','A','C','c','b_code'])
+    else:
+        d=selected
+    gamma=float(d['gamma']);a=np.array(d['A'],float);C=np.array(d['C'],float)
+    invGamma=np.eye(8)/gamma-C;Gamma=np.linalg.inv(invGamma)
+    alpha=a@Gamma;b=Gamma.T@np.array(d['b_code'],float)
+    return gamma,a,C,Gamma,alpha,b,np.array(d['b_code'],float),np.array(d['c'],float)
+
+def gmres(apply,b):
+    n=len(b);beta=np.linalg.norm(b)
+    if beta==0:return np.zeros(n),0.,0
+    V=np.zeros((n,n+1));H=np.zeros((n+1,n));V[:,0]=b/beta
+    x=np.zeros(n);used=0
+    for k in range(n):
+        w=apply(V[:,k]);used+=1
+        for _ in range(2):
+            for j in range(k+1):
+                a=np.dot(V[:,j],w);H[j,k]+=a;w-=a*V[:,j]
+        H[k+1,k]=np.linalg.norm(w)
+        if H[k+1,k]>0 and k+1<n+1:V[:,k+1]=w/H[k+1,k]
+        rhs=np.zeros(k+2);rhs[0]=beta
+        coef=np.linalg.lstsq(H[:k+2,:k+1],rhs,rcond=None)[0]
+        x=V[:,:k+1]@coef
+        # True residual, not just a projected estimate.
+        r=np.linalg.norm(b-apply(x));used+=1
+        if r<=1e-13*max(1.,beta):return x,float(r),used
+    if r>2e-11*max(1.,beta):raise RuntimeError(f'GMRES residual {r} for {beta}')
+    return x,float(r),used
+
+def one_step(n,h,nonidentity_mass,mode):
+    gamma,a,C,Gamma,alpha,b,bcode,c=tableau()
+    y=.5+np.arange(n)/(2*n);lam=np.geomspace(1.,300.,n)
+    q=.02;beta=.1;t=.125;ft=np.linspace(.1,.2,n)
+    mass=np.linspace(1.,2.,n) if nonidentity_mass else np.ones(n)
+    count={'rhs':0,'rhs_jvp':0,'solve_and_residual_jvp':0,'explicit_jacobian':0,'mass_actions':0}
+    def rhs(tt,v):
+        count['rhs']+=1;out=-lam*v+q*v*v+ft*tt
+        out[1:]+=beta*v[:-1];return out
+    def jvp(v,cat):
+        count[cat]+=1;out=(-lam+2*q*y)*v;out=out.copy();out[1:]+=beta*v[:-1];return out
+    def mvp(v):count['mass_actions']+=1;return mass*v
+    def shifted(v):return mvp(v)-h*gamma*jvp(v,'solve_and_residual_jvp')
+    K=np.zeros((8,n));residuals=[]
+    rowsums=np.sum(Gamma,axis=1)
+    for i in range(8):
+        if mode=='original':
+            state=y+alpha[i,:i]@K[:i]
+            f=rhs(t+c[i]*h,state)
+            mix=Gamma[i,:i]@K[:i]
+            jmix=jvp(mix,'rhs_jvp') if np.any(mix) else np.zeros(n)
+            stage_rhs=h*f+h*jmix+h*h*rowsums[i]*ft
+        else:
+            state=y+a[i,:i]@K[:i]
+            f=rhs(t+c[i]*h,state)
+            cmix=C[i,:i]@K[:i]
+            stage_rhs=h*gamma*f+gamma*mvp(cmix)+h*h*gamma*rowsums[i]*ft
+        K[i],r,_=gmres(shifted,stage_rhs);residuals.append(r)
+    weights=b if mode=='original' else bcode
+    new=y+weights@K
+    embedded=Gamma[-1]@K if mode=='original' else K[-1].copy()
+    return new,embedded,K,count,max(residuals)
+
+def run():
+    rows=[]
+    for n in (2,8,16):
+        for h in (.001,.05):
+            for mass in (False,True):
+                y,e,K,c,r=one_step(n,h,mass,'original')
+                yt,et,U,ct,rt=one_step(n,h,mass,'transformed')
+                Gamma=tableau()[3]
+                delta=float(np.max(abs(y-yt)));de=float(np.max(abs(e-et)))
+                stage=float(np.max(abs(U-Gamma@K)))
+                assert delta<2e-10 and de<2e-10 and stage<2e-10
+                assert c['rhs_jvp']==7 and ct['rhs_jvp']==0
+                assert c['explicit_jacobian']==ct['explicit_jacobian']==0
+                rows.append({'dimension':n,'h':h,'nonidentity_constant_mass':mass,
+                    'endpoint_max_difference':delta,'embedded_max_difference':de,
+                    'stage_transform_max_difference':stage,'old_counts':c,'new_counts':ct,
+                    'old_true_residual_max':r,'new_true_residual_max':rt})
+    out={'scope':'source-informed JVP-only Python reference, no Rust execution, no adaptive driver',
+         'coefficient_identity':'byte-exact raw snapshot; Gamma rederived by NumPy (not faer bit identity)',
+         'cases':rows,'cases_passed':len(rows),'removed_rhs_jvp_per_step':7,
+         'still_required':'native target allowance, mapped residual budget, dense output, rejected-step transaction, native contracts',
+         'speedup':'NOT_MEASURED'}
+    (ROOT/'results/matrix_free_transformed_probe.json').write_text(json.dumps(out,indent=2)+'\n')
+    print('cases',len(rows),'worst endpoint',max(r['endpoint_max_difference'] for r in rows),
+          'worst embedded',max(r['embedded_max_difference'] for r in rows))
+    return out
+if __name__=='__main__':run()
