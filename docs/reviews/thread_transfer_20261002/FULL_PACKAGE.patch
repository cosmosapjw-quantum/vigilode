+"""Exploratory independent enclosure probe of the pinned R4 diagonal study.
+
+Uses pinned native coefficient bits and coupling intervals. Exact rational
+arithmetic followed by upward dyadic quantization gives new valid bounds,
+not bit identity with the Rust outward-arithmetic implementation. No benchmark.
+"""
+from __future__ import annotations
+from fractions import Fraction as F
+from pathlib import Path
+import json, struct, math
+
+ROOT=Path(__file__).resolve().parents[1]
+BITS=100
+SCALE=1<<BITS
+
+def up(x:F)->F:
+    if x < 0: raise ValueError('nonnegative enclosure required')
+    return F((x.numerator*SCALE+x.denominator-1)//x.denominator,SCALE)
+
+def hexfrac(x:str)->F:
+    return F.from_float(struct.unpack('>d',bytes.fromhex(x))[0])
+
+def interval_mul_scalar(interval, scalar):
+    a,b=(interval[0]*scalar,interval[1]*scalar)
+    return (min(a,b),max(a,b))
+
+def load():
+    raw=json.loads((ROOT/'inputs/stage_target_sequential_bits.json').read_text())
+    alpha=[[hexfrac(x) for x in r] for r in raw['alpha_rows']]
+    coupling=[[(hexfrac(x),hexfrac(y)) for x,y in r] for r in raw['coupling_rows']]
+    gamma=hexfrac(raw['gamma'])
+    return alpha,coupling,gamma
+
+def component(a,c,gamma,index):
+    # Same scalar problem construction as r4_studies.rs. Binary input values.
+    qf=-0.05*(1+index%3); yf=1.0+0.1*index
+    jf=(-1.0-index)+2.0*qf*yf
+    ff=jf*yf-2.0*qf*yf*yf+qf*yf*yf
+    q,y,j,h,khat=map(F.from_float,[qf,yf,jf,0.05,0.05*ff])
+    w=1-h*gamma*j
+    assert w>0
+    u=1/w
+    abs_c=[[max(abs(x),abs(y)) for x,y in r] for r in c]
+    d=[abs(sum((x*khat for x in row),F(0))) for row in a]
+    residual=[]
+    for i in range(8):
+        clo=sum((interval_mul_scalar(x,khat)[0] for x in c[i]),F(0))
+        chi=sum((interval_mul_scalar(x,khat)[1] for x in c[i]),F(0))
+        lin=interval_mul_scalar((clo,chi),h*j)
+        base=w*khat-h*(j*y-q*y*y)-h*q*d[i]*d[i]
+        residual.append(max(abs(base-lin[0]),abs(base-lin[1])))
+    seed=[up(u*r) for r in residual]
+    def with_radius(D):
+        Ds=[D]*8 if isinstance(D,F) else D
+        e=[]
+        for i in range(8):
+            hi=[h*u*(abs(j)*abs_c[i][p]+abs(q)*(2*d[i]+Ds[i])*abs(a[i][p])) for p in range(i)]
+            e.append(up(seed[i]+sum((v*e[p] for p,v in enumerate(hi)),F(0))))
+        actual=[up(sum((abs(a[i][p])*e[p] for p in range(i)),F(0))) for i in range(8)]
+        return e,actual
+    def causal():
+        e=[];D=[]
+        for i in range(8):
+            dr=up(sum((abs(a[i][p])*e[p] for p in range(i)),F(0)))
+            D.append(dr)
+            lin=sum((abs_c[i][p]*e[p] for p in range(i)),F(0))
+            e.append(up(seed[i]+h*u*(abs(j)*lin+abs(q)*(2*d[i]*dr+dr*dr))))
+        return e,D
+    # Anisotropic supersolution proposal from the causal bounds, with a strict margin.
+    # This is not a parallel speedup: construction cost must be charged.
+    es,ds=causal()
+    proposal=[up(F(1001,1000)*v+F(1,SCALE)) for v in ds]
+    ec,dc=with_radius(proposal)
+    # Larger D can increase downstream bounds; expand bounded retries if necessary.
+    tries=0
+    while not all(x<=y for x,y in zip(dc,proposal)) and tries<8:
+        proposal=[up(max(x,y)*F(1001,1000)+F(1,SCALE)) for x,y in zip(dc,proposal)]
+        ec,dc=with_radius(proposal);tries+=1
+    return {'seed':seed,'increments':d,'with_radius':with_radius,'serial':es,'serial_radii':ds,
+            'anisotropic':proposal,'anisotropic_closes':all(x<=y for x,y in zip(dc,proposal)),
+            'anisotropic_rechecks':tries+1}
+
+def run():
+    a,c,g=load(); comps=[component(a,c,g,i) for i in range(16)]
+    rows=[]
+    for n in (1,2,4,8,16):
+        trials=[]
+        for k in range(10):
+            D=F.from_float(0.001)*4**k
+            required=max(max(comps[i]['with_radius'](D)[1]) for i in range(n))
+            trials.append({'attempt':k+1,'radius':float(D),'required':float(required),'closes':required<=D})
+        first=next((t for t in trials if t['closes']),None)
+        linear_floor=max(max(comps[i]['with_radius'](F(0))[1]) for i in range(n))
+        proposal=up(F(11,10)*linear_floor+F(1,SCALE))
+        proposal_req=max(max(comps[i]['with_radius'](proposal)[1]) for i in range(n))
+        row={'dimension':n,'zero_radius_preflight_lower_floor':float(linear_floor),
+             'preflight_1p1_proposal':float(proposal),'preflight_proposal_required':float(proposal_req),
+             'preflight_proposal_closes':proposal_req<=proposal,'old_schedule_closes':any(t['closes'] for t in trials[:6]),
+             'first_extended_schedule_closure':first,'trials':trials,
+             'max_causal_radius':float(max(max(comps[i]['serial_radii']) for i in range(n))),
+             'anisotropic_verified':all(comps[i]['anisotropic_closes'] for i in range(n)),
+             'anisotropic_rechecks_max':max(comps[i]['anisotropic_rechecks'] for i in range(n))}
+        rows.append(row)
+    assert [r['old_schedule_closes'] for r in rows]==[True,True,True,False,False]
+    assert all(r['anisotropic_verified'] for r in rows)
+    # Exact synthetic triangular system: no common scalar radius can close, even
+    # though causal component radii [0,1,2] exist. Distinguish from actual fixture.
+    synthetic={'stages':3,'equations':'k0=1; k1=1+k0^2; k2=1+k1^2',
+               'unique_root':[1,2,5], 'zero_candidate':True,
+               'common_radius_obstruction':'state radius at stage 2 equals 1+D > D for every D>=0',
+               'anisotropic_state_radii':[0,1,2]}
+    result={'scope':'exploratory source-informed enclosure study; not Rust execution, not preregistered admission',
+            'arithmetic':f'exact IEEE input rationals, positive bounds rounded upward to dyadic grid 2^-{BITS}',
+            'rows':rows,'synthetic_common_radius_no_go':synthetic,
+            'native_interval_operations_bit_parity':'NOT_CLAIMED',
+            'speedup':'NOT_MEASURED; serial predictor cost explicitly retained'}
+    (ROOT/'results/homotopy_radius_probe.json').write_text(json.dumps(result,indent=2)+'\n')
+    for r in rows:print(r['dimension'],r['old_schedule_closes'],r['first_extended_schedule_closure'],r['max_causal_radius'])
+    return result
+if __name__=='__main__':run()
