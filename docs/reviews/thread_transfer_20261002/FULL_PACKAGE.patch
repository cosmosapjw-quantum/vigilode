+#!/usr/bin/env python3
+"""Replay the research probes in a temporary copy, never mutate pinned inputs.
+
+Run from an extracted package or inside the repo. The default receipt directory
+is printed; --output must be outside the review payload. No GitHub writes occur.
+"""
+from __future__ import annotations
+import argparse,hashlib,json,os,shutil,subprocess,sys,tempfile,time
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__);p.add_argument('--output',type=Path)
+    args=p.parse_args();out=(args.output or Path(tempfile.mkdtemp(prefix='vigilode-review-results-'))).resolve()
+    if out.is_relative_to(ROOT.resolve()):raise ValueError('receipt directory must be outside immutable review payload')
+    out.mkdir(parents=True,exist_ok=True)
+    before={str(f.relative_to(ROOT)):hashlib.sha256(f.read_bytes()).hexdigest() for f in ROOT.rglob('*') if f.is_file() and '__pycache__' not in f.parts}
+    env=dict(os.environ,PYTHONDONTWRITEBYTECODE='1');records=[]
+    with tempfile.TemporaryDirectory(prefix='vigilode-review-replay-') as t:
+        work=Path(t)/'review';shutil.copytree(ROOT,work,ignore=shutil.ignore_patterns('__pycache__'))
+        jobs=[('review',f'probes/{name}') for name in ['test_review_contracts.py','homotopy_radius_probe.py','path_action_probe.py','laguerre_adjoint_probe.py','matrix_free_transformed_probe.py']]
+        thread=Path(t)/'thread';(thread/'proofs').mkdir(parents=True);(thread/'results').mkdir()
+        for f in (ROOT/'inputs/thread_loop3/proofs').glob('*.py'):shutil.copy2(f,thread/'proofs'/f.name)
+        jobs += [('thread','proofs/verify_exact_loop3.py'),('thread','proofs/verify_numeric_loop3.py')]
+        for kind,relative in jobs:
+            wd=work if kind=='review' else thread;started=time.perf_counter()
+            cp=subprocess.run([sys.executable,str(wd/relative)],cwd=wd,text=True,capture_output=True,env=env,timeout=180)
+            log=Path(relative).name+'.log';(out/log).write_text(cp.stdout+'\n'+cp.stderr)
+            records.append({'job':kind+'/'+relative,'exit_code':cp.returncode,'wall_seconds_diagnostic':time.perf_counter()-started,'log':log})
+            if cp.returncode:raise RuntimeError(f'failed {kind}/{relative}; see {out/log}')
+        for d,prefix in [(work/'results',''),(thread/'results','thread_replayed_')]:
+            for f in d.glob('*.json'):shutil.copy2(f,out/(prefix+f.name))
+    unchanged=all((ROOT/f).is_file() and hashlib.sha256((ROOT/f).read_bytes()).hexdigest()==sha for f,sha in before.items())
+    if not unchanged:raise AssertionError('source payload changed')
+    receipt={'jobs':records,'all_jobs_exit_zero':True,'source_payload_unchanged':unchanged,'github_mutation':False,'native_rust_run':False,'receipt_directory':str(out)}
+    (out/'REPLAY_RECEIPT.json').write_text(json.dumps(receipt,indent=2)+'\n');print(json.dumps(receipt,indent=2))
+if __name__=='__main__':main()
