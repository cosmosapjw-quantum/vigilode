+
+def exp_control_step(st,h,kk):
+    xx,yy=st; ee=yy-xx*xx/kk; aa=-kk+2*xx
+    ps=exact_phi5(2*h*xx); pf=exact_phi5(h*aa); c=cjf(xx,kk)
