+(* Connected Wolfram executed this algebra; local replay not run. *)
+Clear[gg,hh,c21,c31,c32,mm11,mm12,mm21,mm22,j11,j12,j21,j22,xx];
+cc={{0,0,0},{c21,0,0},{c31,c32,0}};
+gi=IdentityMatrix[3]/gg-cc;ga=Inverse[gi];
+mm={{mm11,mm12},{mm21,mm22}};jj={{j11,j12},{j21,j22}};
+old=KroneckerProduct[IdentityMatrix[3],mm]-hh KroneckerProduct[ga,jj];
+new=KroneckerProduct[IdentityMatrix[3],mm-hh gg jj]-gg KroneckerProduct[cc,mm];
+resid=FullSimplify[new-gg old.KroneckerProduct[gi,IdentityMatrix[2]],Assumptions->gg!=0];
+m=5;cf=Table[(1/4)(3/4)^i,{i,0,m}];zz=ConstantArray[0,m+3];
+Do[zz[[i+1]]=Expand[cf[[i+1]]+((2i+1-xx)/(i+1))zz[[i+2]]-((i+1)/(i+2))zz[[i+3]]],{i,m,0,-1}];
+dd=Array[d,m];ee=Join[{0},ConstantArray[0,m]];
+Do[ee[[i+2]]=Expand[((2i+1-xx)/(i+1))ee[[i+1]]-If[i>0,i/(i+1)ee[[i]],0]+dd[[i+1]]],{i,0,m-1}];
+lhs=Sum[cf[[i+1]]ee[[i+1]],{i,0,m}];rhs=Sum[zz[[i+1]]dd[[i]],{i,1,m}];
+<|"TransformedMassResidualScaling"->(resid===ConstantArray[0,{6,6}]),
+"LaguerreAdjointIdentity"->(Expand[lhs-rhs]===0),
