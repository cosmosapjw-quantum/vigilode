+"""Exact finite nilpotent path action; exploratory, not a native speedup claim."""
+from __future__ import annotations
+from fractions import Fraction as F
+from pathlib import Path
+import json
+ROOT=Path(__file__).resolve().parents[1]
+
+def validate(H,a):
+    n=len(a)
+    if n<1 or len(H)!=n or any(len(r)!=n for r in H):raise ValueError('shape')
+    if any(v<0 for v in a) or any(v<0 for r in H for v in r):raise ValueError('negative input')
+    if any(H[i][j] for i in range(n) for j in range(i,n)):raise ValueError('not strictly lower')
+    return n
+
+def mm(A,B):
+    n=len(A)
+    return [[sum((A[i][k]*B[k][j] for k in range(n)),F(0)) for j in range(n)] for i in range(n)]
+
+def mv(A,x):return [sum((v*w for v,w in zip(r,x)),F(0)) for r in A]
+def madd(A,B):return [[x+y for x,y in zip(r,s)] for r,s in zip(A,B)]
+def vadd(a,b):return [x+y for x,y in zip(a,b)]
+
+def full(H,a):
+    n=validate(H,a);L=(n-1).bit_length();S=[[F(i==j) for j in range(n)] for i in range(n)];Q=H
+    for ell in range(L):
+        S=madd(S,mm(Q,S))
+        if ell+1<L:Q=mm(Q,Q)
+    return mv(S,a)
+
+def action(H,a):
+    n=validate(H,a);L=(n-1).bit_length();e=a[:];Q=H
+    for ell in range(L):
+        e=vadd(e,mv(Q,e))  # old e on the entire right hand side
+        if ell+1<L:Q=mm(Q,Q)
+    return e
+
+def causal(H,a):
+    n=validate(H,a);out=[]
+    for i in range(n):out.append(a[i]+sum((H[i][j]*out[j] for j in range(i)),F(0)))
+    return out
+
+def run():
+    rows=[]
+    for n in [1,3,8,9,16]:
+        H=[[F((i+2*j)%5+1,37) if j<i and (i+j)%3 else F(0) for j in range(n)] for i in range(n)]
+        a=[F(i+1,19) for i in range(n)]
+        expected=causal(H,a);A=action(H,a);B=full(H,a)
+        assert A==B==expected
+        L=(n-1).bit_length()
+        rows.append({'width':n,'levels':L,'exact_action_equals_full_and_causal':True,
+          'formal_dense_full_mm':max(0,2*L-1),'formal_dense_action_mm':max(0,L-1),
+          'formal_dense_full_mv':1,'formal_dense_action_mv':L,
+          'max_output':str(max(A))})
+    invalid=0
+    for H,a in [([[F(1)]],[F(1)]),([[F(0),F(1)],[F(0),F(0)]],[F(1),F(1)]),([[F(0)]],[F(-1)]),([],[])]:
+        try:action(H,a)
+        except ValueError:invalid+=1
+        else:raise AssertionError('invalid premise admitted')
+    result={'scope':'exact real-arithmetic algorithm identity and premise rejection, not floating-point parity or native timing',
+            'rows':rows,'invalid_inputs_rejected':invalid,
+            'stage_block_note':'production H has s stage blocks; use ceil(log2(s)), not ceil(log2(s*n)), once block strict-lower structure is certified',
+            'native_execution':False,'speedup':'NOT_MEASURED'}
+    (ROOT/'results/path_action_probe.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result,indent=2));return result
+if __name__=='__main__':run()
