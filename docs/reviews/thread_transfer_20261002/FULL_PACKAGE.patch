+            'claim_ceiling':'recurrence and summation error of stored finite polynomial; no phi total certificate'}
+
+def run(quick=False):
+    configs=[(16,F(1),F(1,2)),(32,F(1),F(3,4)),(64,F(1),F(3,4)),(32,F(4),F(3,4)),(64,F(4),F(3,4)),(32,F(16),F(3,4))]
+    if quick:configs=configs[:2]
+    rows=[]
