+// PREPARED, NOT COMPILED OR EXECUTED in the review environment.
+// Copy only for a preregistered native replay to:
+// crates/rodas5p-integrators/tests/thread_transfer_radius.rs
+// cargo test --release -p rodas5p-integrators --locked --test thread_transfer_radius -- --nocapture
+// This does not change the old R4 result or its six-attempt gate.
+use rodas5p_core::rodas5p_coefficients;
+use rodas5p_integrators::{
+    InverseWitness, ParallelExecution, Q2CertificateSource, QuadraticModel, StageTarget,
+    blocked_doubling_certificate_with_execution,
+};
+
+#[test]
+fn extended_radius_schedule_is_separate_from_the_original_failed_gate() {
+    let coeffs = rodas5p_coefficients().unwrap();
+    let target = StageTarget::sequential(coeffs).unwrap();
+    let execution = ParallelExecution::sequential();
+    for n in [8_usize, 16] {
+        let a = (0..n).map(|i| (0..n).map(|j|
+            if i == j { -1.0 - i as f64 } else { 0.0 }
+        ).collect::<Vec<_>>()).collect::<Vec<_>>();
+        let q = (0..n).map(|i| -0.05 * (1 + i % 3) as f64).collect();
+        let model = QuadraticModel::new(format!("review-diagonal-quadratic-{n}"), a, q).unwrap();
+        let y = (0..n).map(|i| 1.0 + 0.1 * i as f64).collect::<Vec<_>>();
+        let h = 0.05;
+        let problem = model.stage_problem(0.0, &y, h).unwrap();
+        let f = (0..n).map(|i| problem.jacobian[i][i] * y[i]
+            - 2.0 * problem.q[i] * y[i] * y[i] + problem.q[i] * y[i] * y[i])
+            .collect::<Vec<_>>();
+        let candidate = vec![f.iter().map(|x| h * x).collect::<Vec<_>>(); 8];
+        let y_hat = y.iter().zip(&f).map(|(y,f)| y + h*f).collect::<Vec<_>>();
+        let e_hat = vec![0.0; n];
+        let witness = InverseWitness::diagonal(&problem, target.gamma).unwrap();
+        let old = blocked_doubling_certificate_with_execution(
+            &target,&problem,&candidate,&y_hat,&e_hat,&witness,1e-8,1e-6,1e-3,6,&execution
+        ).unwrap();
+        assert!(old.doubling.certificate.is_none(), "preserve the old failed schedule");
+        let new = blocked_doubling_certificate_with_execution(
+            &target,&problem,&candidate,&y_hat,&e_hat,&witness,1e-8,1e-6,1e-3,8,&execution
+        ).unwrap();
+        assert!(new.doubling.certificate.is_some());
+        assert_eq!(new.doubling.attempts.len(), if n==8 {7} else {8});
+        println!("n={n}: {:?}", new.doubling.attempts);
+    }
+}
