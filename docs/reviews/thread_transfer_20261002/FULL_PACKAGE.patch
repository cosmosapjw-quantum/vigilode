+from __future__ import annotations
+import hashlib,importlib.util,json,subprocess,tempfile,unittest
+from fractions import Fraction as F
+from pathlib import Path
+from unittest.mock import patch
+import numpy as np
+import homotopy_radius_probe as h
+import laguerre_adjoint_probe as l
+import matrix_free_transformed_probe as m
+
+ROOT=Path(__file__).resolve().parents[1]
+spec=importlib.util.spec_from_file_location('publisher',ROOT/'publication/apply_same_branch.py')
+pub=importlib.util.module_from_spec(spec);spec.loader.exec_module(pub)
+
+class MathContracts(unittest.TestCase):
+    def test_native_bit_shape(self):
+        a,c,g=h.load();self.assertEqual([len(r) for r in a],list(range(8)))
+        self.assertTrue(all(x<=y for r in c for x,y in r));self.assertGreater(g,0)
+    def test_upward_dyadic(self):
+        for v in [F(0),F(1,3),F(10**30,7),F(1,10**40)]:self.assertGreaterEqual(h.up(v),v)
+        with self.assertRaises(ValueError):h.up(F(-1))
+    def test_bernstein_convex_hull(self):
+        # p=x-x^2 on [0,1], Bernstein coefficients [0,1/2,0].
+        b=l.bernstein([F(0),F(1),F(-1)],F(1))
+        self.assertEqual(b,[F(0),F(1,2),F(0)])
+        self.assertEqual(l.bound_bernstein(b,1),F(1,4))
+    def test_adjoint_basis_weights(self):
+        p=l.adjoints([F(0),F(0),F(1)])
+        self.assertEqual(p[2],[F(1)])
+        self.assertEqual(p[1],[F(3,2),-F(1,2)])
+    def test_norm_enclosure(self):
+        for v in ([F(3),F(4)],[F(1,3),F(1,7)],[F(0)]):
+            r=l.norm_upper(v);self.assertGreaterEqual(r*r,sum(x*x for x in v))
+    def test_gmres_current_operator_residual(self):
+        A=np.array([[2.,1.],[0.,3.]]);b=np.array([1.,-1.])
+        x,r,count=m.gmres(lambda x:A@x,b)
+        self.assertLess(np.linalg.norm(A@x-b),1e-12);self.assertGreater(count,0)
+    def test_gmres_zero_rhs(self):
+        x,r,count=m.gmres(lambda x:x,np.zeros(2));self.assertEqual(count,0);self.assertEqual(r,0)
+    def test_radius_synthetic_obstruction(self):
+        for D in [F(0),F(1),F(1000000)]:self.assertGreater(1+D,D)
+        self.assertEqual([1,1+1**2,1+(1+1**2)**2],[1,2,5])
+
+class PublicationContracts(unittest.TestCase):
+    def payload(self,root):
+        p=root/'payload';p.mkdir();(p/'REVIEW.txt').write_text('test-only payload\n')
+        (p/'MANIFEST.json').write_text(json.dumps({'files':[{'path':'REVIEW.txt','sha256':hashlib.sha256((p/'REVIEW.txt').read_bytes()).hexdigest()}]}))
+        return p
+    def test_remote_identity(self):
+        pub.check_remote_identity('https://github.com/cosmosapjw-quantum/vigilode.git')
+        pub.check_remote_identity('git@github.com:cosmosapjw-quantum/vigilode.git')
+        for s in ['https://example.com/vigilode.git','https://github.com/another/repo.git','file:///tmp/repo']:
+            with self.assertRaises(RuntimeError):pub.check_remote_identity(s)
+    def test_push_needs_apply(self):
+        with self.assertRaises(ValueError):pub.execute(Path('/missing'),push=True)
+    def test_manifest_tamper(self):
+        with tempfile.TemporaryDirectory() as t:
+            p=self.payload(Path(t));(p/'REVIEW.txt').write_text('changed')
+            with self.assertRaises(RuntimeError):pub.verify_payload(p)
+    def test_manifest_symlink(self):
+        with tempfile.TemporaryDirectory() as t:
+            p=self.payload(Path(t));(p/'REVIEW.txt').unlink();(p/'REVIEW.txt').symlink_to(p/'MANIFEST.json')
+            with self.assertRaises(RuntimeError):pub.verify_payload(p)
+    def test_existing_branch_local_git_smoke(self):
+        # This is a disposable filesystem origin, NOT the user's GitHub remote.
+        with tempfile.TemporaryDirectory() as t:
+            root=Path(t);origin=root/'origin.git';repo=root/'checkout';p=self.payload(root)
+            def run(*cmd):
+                r=subprocess.run(cmd,text=True,capture_output=True);self.assertEqual(r.returncode,0,r.stderr);return r.stdout.strip()
+            run('git','init','--bare',str(origin));run('git','init','-b',pub.BRANCH,str(repo))
+            run('git','-C',str(repo),'config','user.name','Review test')
+            run('git','-C',str(repo),'config','user.email','review-test@example.invalid')
+            (repo/'BASE.txt').write_text('fixture\n')
+            run('git','-C',str(repo),'add','BASE.txt');run('git','-C',str(repo),'commit','-m','fixture base')
+            run('git','-C',str(repo),'remote','add','origin',str(origin))
+            run('git','-C',str(repo),'push','-u','origin',pub.BRANCH)
+            base=run('git','-C',str(repo),'rev-parse','HEAD')
+            with patch.object(pub,'BASE_SHA',base),patch.object(pub,'check_remote_identity',lambda _:None):
+                d=pub.execute(repo,p);self.assertEqual(d['status'],'DRY_RUN_PREFLIGHT_OK')
+                self.assertFalse((repo/pub.REPORT_RELATIVE).exists())
+                r=pub.execute(repo,p,apply=True,push=True)
+                self.assertEqual(r['status'],'PUSHED_EXISTING_BRANCH_R1')
+                refs=run('git','--git-dir',str(origin),'for-each-ref','--format=%(refname)','refs/heads').splitlines()
+                self.assertEqual(refs,[f'refs/heads/{pub.BRANCH}'])
+                paths=run('git','-C',str(repo),'diff-tree','--no-commit-id','--name-only','-r','HEAD').splitlines()
+                self.assertTrue(all(s.startswith(str(pub.REPORT_RELATIVE)+'/') for s in paths))
+                with self.assertRaises(RuntimeError):pub.execute(repo,p,apply=True)
+
+if __name__=='__main__':unittest.main(verbosity=2)
