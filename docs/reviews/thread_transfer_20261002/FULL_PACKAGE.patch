+++ b/docs/reviews/thread_transfer_20261002/publication/apply_same_branch.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Add only this review folder on the pinned existing branch. Dry run by default.
+
+This script never creates/switches a branch, rebases, overwrites a report,
+forces a push, opens a PR, or edits scientific/timing authority. A changed
+remote HEAD requires a fresh review, not an override flag.
+"""
+from __future__ import annotations
+import argparse,hashlib,json,re,shutil,subprocess,sys
+from pathlib import Path
+from urllib.parse import urlparse
+
+BRANCH='claude/jolly-wozniak-7wl15h-wu25-stiff-benchmark'
+BASE_SHA='687def63d3f6d24297d37bc1cb1a99558be2d71f'
+REPO_NAME='cosmosapjw-quantum/vigilode'
+REPORT_RELATIVE=Path('docs/reviews/thread_transfer_20261002')
+PAYLOAD=Path(__file__).resolve().parents[1]
+
+def git(repo,*args):
+    result=subprocess.run(['git','-C',str(repo),*args],text=True,capture_output=True,timeout=120)
+    if result.returncode:
+        err=re.sub(r'https://[^\s/@]+(?::[^\s/@]+)?@','https://[redacted]@',result.stderr.strip())
+        raise RuntimeError(f'git {args[0]} failed ({result.returncode}): {err}')
+    return result.stdout.strip()
+
+def check_remote_identity(url):
+    if url.startswith('git@github.com:'):
+        name=url.split(':',1)[1]
+    else:
+        p=urlparse(url)
+        if p.scheme not in ('https','ssh') or p.hostname!='github.com':
+            raise RuntimeError('origin is not the approved GitHub repository')
+        name=p.path.lstrip('/')
+    if name.removesuffix('.git')!=REPO_NAME:
+        raise RuntimeError('origin repository identity does not match approval')
+
+def remote_head(repo):
+    lines=git(repo,'ls-remote','--heads','origin',f'refs/heads/{BRANCH}').splitlines()
+    if len(lines)!=1:raise RuntimeError('approved existing remote branch is missing or ambiguous')
+    sha,ref=lines[0].split()
+    if ref!=f'refs/heads/{BRANCH}':raise RuntimeError('unexpected remote ref')
+    return sha
+
+def verify_payload(payload):
+    manifest=json.loads((payload/'MANIFEST.json').read_text())
+    names=[]
+    for item in manifest['files']:
+        name=Path(item['path'])
+        if name.is_absolute() or '..' in name.parts:raise RuntimeError('unsafe manifest path')
+        path=payload/name
+        if path.is_symlink() or not path.is_file():raise RuntimeError(f'non-regular payload file: {name}')
+        if not path.resolve().is_relative_to(payload.resolve()):raise RuntimeError('payload escapes root')
+        if hashlib.sha256(path.read_bytes()).hexdigest()!=item['sha256']:
+            raise RuntimeError(f'payload checksum mismatch: {name}')
+        names.append(name)
+    if len(names)!=len(set(names)):raise RuntimeError('duplicate manifest paths')
+    return names+[Path('MANIFEST.json')]
+
+def preflight(repo,payload):
+    repo=repo.resolve()
+    names=verify_payload(payload)
+    if git(repo,'symbolic-ref','--short','HEAD')!=BRANCH:
+        raise RuntimeError('checkout is not the approved existing branch; no branch switch attempted')
+    if git(repo,'status','--porcelain','--untracked-files=all'):
+        raise RuntimeError('working tree/index must be clean; unrelated files will not be staged')
+    if git(repo,'rev-parse','HEAD')!=BASE_SHA:
+        raise RuntimeError('local HEAD changed; fresh source review required')
+    check_remote_identity(git(repo,'remote','get-url','origin'))
+    if remote_head(repo)!=BASE_SHA:
+        raise RuntimeError('remote HEAD changed; fresh source review required')
+    destination=repo/REPORT_RELATIVE
+    if destination.exists():raise RuntimeError('create-only report already exists')
+    if not destination.resolve().is_relative_to(repo):raise RuntimeError('destination escapes checkout')
+    return destination,names
+
+def execute(repo,payload=PAYLOAD,apply=False,push=False):
+    if push and not apply:raise ValueError('--push requires --apply')
+    destination,names=preflight(repo,payload)
+    receipt={'repository':REPO_NAME,'branch':BRANCH,'reviewed_base':BASE_SHA,
+             'report_folder':str(REPORT_RELATIVE),'status':'DRY_RUN_PREFLIGHT_OK','remote_mutation':False}
+    if not apply:return receipt
+    destination.mkdir(parents=True,exist_ok=False)
+    for name in names:
+        dest=destination/name;dest.parent.mkdir(parents=True,exist_ok=True)
+        shutil.copyfile(payload/name,dest)
+    git(repo,'add','--',str(REPORT_RELATIVE))
+    staged=git(repo,'diff','--cached','--name-only').splitlines()
+    if not staged or not all(p.startswith(str(REPORT_RELATIVE)+'/') for p in staged):
+        raise RuntimeError('index scope changed; refusing commit')
+    git(repo,'commit','-m','docs: review thread transfer, radius policy and Laguerre error transport')
+    commit=git(repo,'rev-parse','HEAD');tree=git(repo,'rev-parse','HEAD^{tree}')
+    receipt.update(status='LOCAL_COMMIT_CREATED_NOT_PUSHED',commit=commit,tree=tree)
+    if push:
+        if remote_head(repo)!=BASE_SHA:raise RuntimeError('remote advanced after preflight; local commit preserved, no push')
+        git(repo,'push','origin',f'HEAD:refs/heads/{BRANCH}')
+        actual=remote_head(repo)
+        if actual!=commit:raise RuntimeError('push acknowledgement lacks matching remote ref; inspect remote')
+        receipt.update(status='PUSHED_EXISTING_BRANCH_R1',remote_mutation=True,
+                       remote_head=actual,verification='commit identity, not restore verification')
+    return receipt
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--repo',type=Path,required=True)
+    p.add_argument('--apply',action='store_true');p.add_argument('--push',action='store_true')
+    p.add_argument('--receipt',type=Path)
+    args=p.parse_args()
+    result=execute(args.repo,apply=args.apply,push=args.push)
+    text=json.dumps(result,indent=2)+'\n'
+    if args.receipt:args.receipt.write_text(text)
+    print(text,end='')
+if __name__=='__main__':main()
