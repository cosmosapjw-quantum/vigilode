  "mission": {
    "problem": "Reduce complete-IVP CPU cost for stiff/oscillatory/nonnormal ODEs while preserving achieved global error and accepted-step economy; reduce explicit Jacobian construction and, in declared routes, derivative and Newton use; exploit only proved stage/operator/spatial/ensemble concurrency.",
    "original_targets": {
      "global_order_min": 4.8,
      "accepted_steps_vs_protected_RJF_max_ratio": 1.2,
      "median_same_global_error_wall_speedup_min": 1.15,
      "fast_lane_explicit_jacobian_builds": 0,
      "fast_lane_newton_iterations": 0,
      "critical_depth_p95_max": 6,
      "critical_depth_absolute_max": 8,
      "fallback_fraction_max": 0.1,
      "status": "GOAL_NOT_ACHIEVED"
    }
  },
  "semantics": {
    "jacobian_free": "No explicit J matrix assembly/storage; exact/approximate Jv may remain.",
    "jvp_based": "Derivative action Jv, not derivative-free.",
    "fd_jvp": "Approximate derivative action with perturbation/truncation/cancellation and additional RHS calls.",
    "derivative_free": "No analytic/AD/FD derivative or JVP action; enforce RHS-only contract.",
    "matrix_free": "Operator not materialized; operator apply, solve and preconditioning remain charged.",
    "newton_free": "No Newton; fixed-point/BE/homotopy needs existence/contraction/branch/original-residual proof.",
    "stage_parallel": "Independent current stages only if selected tableau dependency graph proves it.",
    "vectorized": "SIMD/lane execution; not automatic reduction of algorithmic work or causal span.",
    "symbolic_dynamics": "C8 means finite-state labelled regime/solver-router sequences; not physical ODE Markov partition or BKL symbolic coding."
  },
