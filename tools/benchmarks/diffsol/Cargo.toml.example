[package]
name = "diffsol_bench"
version = "0.1.0"
edition = "2021"

[dependencies]
diffsol = { version = "0.16.1", default-features = false, features = ["faer", "nalgebra"] }
rodas5p-core = { path = "../../../crates/rodas5p-core" }
rodas5p-integrators = { path = "../../../crates/rodas5p-integrators" }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
