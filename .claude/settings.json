{
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git commit --amend *)",
      "Bash(python3 tools/agent_gate.py approve *)",
      "Bash(* agent_gate.py approve *)",
      "Edit(/docs/agent/switcher_v2_remediation/DESIGN.md)",
      "Edit(/docs/agent/switcher_v2_remediation/TASKS.json)",
      "Edit(/tools/agent_gate.py)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/Cargo.lock)",
      "Edit(/rust-toolchain.toml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/agent_gate.py\" pre-edit",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/agent_gate.py\" stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
